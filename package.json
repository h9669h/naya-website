{
  "name": "NAYA-corp-website",
  "version": "1.0.0",
  "private": true,
  "description": "Naya Corp 现代化科技企业官网全栈项目",
  "license": "MIT",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.18"
    }
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ./backend --filter ./frontend dev",
    "build": "pnpm --filter ./backend build && pnpm --filter ./frontend build",
    "start": "pnpm --parallel --filter ./backend --filter ./frontend start",
    "lint": "pnpm --filter ./backend lint && pnpm --filter ./frontend lint",
    "typecheck": "pnpm --filter ./backend typecheck && pnpm --filter ./frontend typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,json,css,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,json,css,md,yml,yaml}\"",
    "prisma:generate": "pnpm --filter ./backend prisma:generate",
    "prisma:migrate": "pnpm --filter ./backend prisma:migrate",
    "prisma:seed": "pnpm --filter ./backend prisma:seed"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
